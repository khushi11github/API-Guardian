{
  "name": "api-guardian",
  "version": "1.0.0",
  "private": true,
  "description": "API monitoring, testing, contract-change detection, and AI-powered root-cause analysis platform",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @api-guardian/api dev\" \"pnpm --filter @api-guardian/web dev\" \"pnpm --filter @api-guardian/worker dev\"",
    "build": "pnpm --filter @api-guardian/shared build && pnpm --filter @api-guardian/api build && pnpm --filter @api-guardian/web build && pnpm --filter @api-guardian/worker build",
    "test": "pnpm --filter @api-guardian/api test && pnpm --filter @api-guardian/shared test",
    "test:api": "pnpm --filter @api-guardian/api test",
    "test:shared": "pnpm --filter @api-guardian/shared test",
    "db:generate": "pnpm --filter @api-guardian/api db:generate",
    "db:migrate": "pnpm --filter @api-guardian/api db:migrate",
    "db:seed": "pnpm --filter @api-guardian/api db:seed",
    "db:studio": "pnpm --filter @api-guardian/api db:studio",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
