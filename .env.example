# ============================================================
# API Guardian — Environment Configuration Example
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/apiguardian?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Server Port & Env
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secrets
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Root-Cause Diagnostic Provider
# Options: "mock" (default, no key needed) | "openai" | "anthropic"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email Notifications (SMTP - Optional, logs to stdout if empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@apiguardian.dev"

# Security & SSRF
ALLOWED_EXTERNAL_ONLY="true"
